[run]
branch = True
source =
    car_wash
    cars
    customer
    personal
    main
omit =
    */migrations/*
    */tests.py
    */admin.py
    */apps.py
    */__init__.py
    manage.py

[report]
fail_under = 80
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
