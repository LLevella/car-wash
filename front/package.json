    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.30.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.1",
